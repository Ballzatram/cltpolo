{
  "schema_version": 1,
  "framework_version": "1.0.0",
  "framework_source": ".engineering",
  "owner": "Ballzatram",
  "repository": "Ballzatram/cltpolo",
  "risk_tier": "standard",
  "lifecycle": "active",
  "profiles": [
    "python",
    "other-languages",
    "web",
    "services"
  ],
  "commands": {
    "format": "uvx --from ruff==0.17.4 ruff format --check .",
    "lint": "python .engineering/tools/audit.py .",
    "types": "node --check script.js",
    "test": "python -m unittest discover -s tests -p \"test_property*.py\"",
    "build": "python scripts/property_pipeline.py --validate-only",
    "security": "gitleaks git --redact --no-banner"
  },
  "components": [
    {
      "path": ".",
      "profile": "python",
      "dependency_manifest": ".engineering/python-runtime.txt",
      "lockfile": ".engineering/python-runtime.txt"
    }
  ]
}
