name: Update Property Dataset

on:
  schedule:
    - cron: "0 11 * * *"  # 7 AM EST
  workflow_dispatch:

jobs:
  update:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repo
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install dependencies
        run: pip install pandas requests beautifulsoup4

      - name: Run script
        run: python scripts/update_properties.py

      - name: Commit changes
        run: |
          git config user.name "auto-agent"
          git config user.email "actions@github.com"
          git add data/charlotte_polo_properties.csv
          git commit -m "Daily property update" || echo "No changes"
          git push